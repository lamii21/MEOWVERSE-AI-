# --- App ---
APP_NAME=MeowVerse AI
ENVIRONMENT=development
DEBUG=true

# --- Database & Cache ---
# Port 5433, not 5432: docker-compose.yml maps the Postgres container to
# host port 5433 specifically to avoid clashing with a native PostgreSQL
# install that may already own 5432 on your machine (it did on the dev
# machine this was built on). If you run Postgres another way, adjust
# accordingly. Container-to-container traffic (e.g. the backend service
# in Docker Compose) is unaffected and always uses `postgres:5432`
# internally regardless of this host-side port.
DATABASE_URL=postgresql+asyncpg://meowverse:meowverse@localhost:5433/meowverse
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Generative AI providers ---
# LLM_PROVIDER selects the implementation behind app.ai.LLMProvider.
# Leave ANTHROPIC_API_KEY unset to run against NullProvider — the app
# stays fully functional, the cat profile screen shows a clearly
# labeled offline/demo profile instead of calling any external API.
#
# To enable real profile generation:
#   1. Get an API key from https://console.anthropic.com/
#   2. Set ANTHROPIC_API_KEY below (never commit this file with a real
#      key filled in — .env itself is gitignored; only .env.example,
#      with empty values, is tracked in git).
#   3. (Optional) Override ANTHROPIC_MODEL if you want a different
#      model than the default — check
#      https://docs.anthropic.com/en/docs/about-claude/models for the
#      current list before changing it.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_MAX_OUTPUT_TOKENS=1024
ANTHROPIC_TIMEOUT_SECONDS=20.0
OPENAI_API_KEY=

IMAGE_GENERATION_PROVIDER=none
IMAGE_GENERATION_API_KEY=
# Set IMAGE_GENERATION_PROVIDER=openai and either IMAGE_GENERATION_API_KEY
# or OPENAI_API_KEY above to enable real AI Cat Portrait Studio generation
# (Phase 14). Without a key, portrait generation returns an honest
# "unavailable" state — never a fake or placeholder image.
IMAGE_GENERATION_MODEL=gpt-image-1
IMAGE_GENERATION_TIMEOUT_SECONDS=60.0
PORTRAIT_OUTPUT_SIZE=1024x1024
PORTRAIT_MAX_BYTES=15728640
PORTRAIT_GENERATION_RATE_LIMIT_PER_MINUTE=5

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=10

# --- Rate limiting ---
# Applied to POST /api/v1/analyses (the only endpoint that can call a
# paid external API) — per client IP, per minute, in-memory.
RATE_LIMIT_PER_MINUTE=20
