# Production configuration template (Phase 17). Copy to
# `backend/.env.production` and fill in real values — never commit that
# file (`.gitignore` already excludes every `.env*` except `*.env.example`
# files like this one).
#
# See PRODUCTION_CHECKLIST.md for the full pre-deploy checklist and
# README.md's deployment section for the reasoning behind each choice
# below.

# --- App ---
APP_NAME=MeowVerse AI
ENVIRONMENT=production
# Never true in production — stack traces must never reach a client
# response (see app/main.py: FastAPI is never constructed with
# debug=True regardless of this flag, but this also controls the root
# logger level; DEBUG-level logs can be verbose enough to leak
# request/response detail, so INFO is the production floor).
DEBUG=false

# --- Database & Cache ---
# A managed Postgres instance (e.g. RDS, Neon, Supabase, Railway,
# Fly Postgres) — not the docker-compose `postgres` service, which is
# for local dev/testing only. `asyncpg` requires `postgresql+asyncpg://`.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
# A managed Redis instance, if you switch the rate limiter to the Redis
# backend (see RATE_LIMIT_BACKEND below) — otherwise unused today.
REDIS_URL=redis://HOST:6379/0

# --- Auth / cookies ---
# REQUIRED true in production: without it, the session cookie is sent
# over plain HTTP, which a real deployment (behind TLS) must never do.
SESSION_COOKIE_SECURE=true

# --- Generative AI providers (OPTIONAL — the app is fully functional
# without either; see README.md's "AI-generated creative content" vs
# "demo fallback" distinction) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_MAX_OUTPUT_TOKENS=1024
ANTHROPIC_TIMEOUT_SECONDS=20.0

IMAGE_GENERATION_PROVIDER=openai
OPENAI_API_KEY=
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_MODEL=gpt-image-1
IMAGE_GENERATION_TIMEOUT_SECONDS=60.0
PORTRAIT_OUTPUT_SIZE=1024x1024
PORTRAIT_MAX_BYTES=15728640
PORTRAIT_GENERATION_RATE_LIMIT_PER_MINUTE=5
EXPLORE_RATE_LIMIT_PER_MINUTE=120

# --- CORS ---
# The real frontend origin(s) only — never "*" in production (enforced
# at startup, see app/core/startup_checks.py: the app refuses to start
# if ENVIRONMENT=production and this contains "*").
CORS_ORIGINS=["https://your-frontend-domain.example.com"]

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=10

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=20
AUTH_RATE_LIMIT_PER_MINUTE=10
# "memory" (the only implementation today) is correct for a
# single-instance deployment; it does NOT share limits across multiple
# backend instances/processes. See ARCHITECTURE.md / PRODUCTION_CHECKLIST.md
# for what a Redis-backed limiter would need before scaling past one
# instance — not implemented, since this deployment doesn't need it yet.
RATE_LIMIT_BACKEND=memory

# --- AI/ML model requirement (Phase 17 §7) ---
# true = startup fails loudly if breed-classifier weights/torch/opencv/
# faiss/scikit-learn aren't actually available, instead of silently
# serving demo-mode analyses under a "real AI" product identity. Set
# false only for a deliberate demo-mode-only deployment.
REQUIRE_ML_MODELS=true
BREED_CLASSIFIER_WEIGHTS_PATH=ml/models/breed_classifier.pt
BREED_CLASSIFIER_CLASS_NAMES_PATH=ml/models/class_names.json

# --- Image storage ---
# "s3" for production (any S3-compatible provider — AWS S3, Cloudflare
# R2, Backblaze B2, DigitalOcean Spaces). "local" does not survive a
# redeploy and does not work across multiple instances — dev/test only.
IMAGE_STORAGE_PROVIDER=s3
S3_BUCKET_NAME=
S3_REGION=auto
# Leave unset for real AWS S3. Set for an S3-compatible provider, e.g.
# https://<account-id>.r2.cloudflarestorage.com for Cloudflare R2.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# A CDN/custom domain in front of the bucket, if any (recommended —
# faster image loads, and avoids exposing the raw bucket endpoint to
# every client). Falls back to the bucket's own URL if unset.
S3_PUBLIC_URL_BASE=

# --- Visual similarity (Phase 11) ---
# The FAISS index file needs a writable, *persistent* path — a
# container's ephemeral filesystem loses it on every redeploy, so mount
# a volume at this path (see PRODUCTION_CHECKLIST.md) or rebuild the
# index from `cat_embeddings` on startup via
# `python -m app.cli.similarity_index rebuild`.
SIMILARITY_INDEX_PATH=/data/similarity_index.faiss
